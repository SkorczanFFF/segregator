# Copy to api/.env and fill in from the dev stack outputs:
# aws cloudformation describe-stacks --stack-name dev-Segregator --query "Stacks[0].Outputs" --output table
AWS_REGION=eu-north-1
TABLE_NAME=
USER_POOL_ID=
USER_POOL_CLIENT_ID=
